{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node", "jest", "@testing-library/jest-dom", "vitest"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src",
    "test/hooks/useDeleteIncome.test.tsx",
    "test/hooks/useIncomeAccounts.test.ts",
    "test/hooks/useIncomeForm.test.tsx",
    "test/hooks/useIncomes.test.tsx",
    "test/components/AddIncomeButton.test.tsx",
    "test/components/DeleteIncomeButton.test.tsx",
    "test/components/EditIncomeButton.test.tsx",
    "test/components/Header.test.tsx",
    "test/components/IncomeTable.test.tsx"
  ]
}
